# Copy to ~/.config/prithvi-wxc/env (chmod 600). bin/prithvi-mcp loads it on start,
# so every MCP host (Claude Code, Claude Desktop, Cursor, ...) gets the same settings.

# Where downloads, code, the training env, logs, and run manifests live.
PIPELINE_DATA_ROOT=$HOME/prithvi-wxc-data

# NASA Earthdata Login (MERRA-2 only). Free: https://urs.earthdata.nasa.gov/
# Alternatively put "machine urs.earthdata.nasa.gov login ... password ..." in ~/.netrc.
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Optional contact string sent to the PRISM web service with each request.
PRISM_CONTACT_EMAIL=

# Optional: Hugging Face token (the weights repo is public; a token raises rate limits).
# HF_TOKEN=

# Code variant from mcp/pins.json: deterministic (default) or stochastic_refinement.
# GRANITE_WXC_VARIANT=deterministic

# Reuse data that already exists elsewhere instead of re-downloading (shared servers).
# MERRA2_DATA_DIR=/data/merra2/daily_subset_with_H
# NARR_DATA_DIR=/data/NARR/data/subset
# PRISM_DATA_DIR=/data/PRISM/prism_daily_800m_an
# ELEVATION_FILE=/data/static/prism_elevation.nc
# MODEL_WEIGHTS_FILE=/data/weights/best_rmse_UNET.pt
# MERRA2_ALLOWED_ROOT=/data

# Use an existing checkout / interpreter instead of the pinned ones (runs are then
# marked non-reproducible in their manifests if the commit differs from the pin).
# GRANITE_WXC_REPO=/path/to/Prithvi-UNet-stocahstic
# GRANITE_WXC_PYTHON=/path/to/conda/envs/prithvi/bin/python
