AZURE_OPENAI_ENDPOINT=... # Replace with your Azure OpenAI endpoint URL
AZURE_OPENAI_API_KEY=... # Replace with your Azure OpenAI API key
DEPLOYMENT_NAME=... # Replace with your Azure OpenAI deployment name

# Optional overrides for training/inference job execution
# GRANITE_WXC_PYTHON=/home/azureuser/miniforge3/envs/Prithvi/bin/python
# GRANITE_WXC_SCRIPT_DIR=/home/azureuser/aashishp/github_merra_test/granite-wxc/examples/MERRA_PRISM
# GRANITE_WXC_REPO=/data2/aashishp/github_merra_test/granite-wxc
# Jobs and YAML writes are jailed to the plugin, ~/prithvi-wxc-data (or PIPELINE_DATA_ROOT),
# and your home directory. Add extra roots with os.pathsep if needed:
# MERRA2_ALLOWED_ROOT=/data

# Required to download MERRA-2 from NASA GES DISC
# EARTHDATA_USERNAME=your_earthdata_username
# EARTHDATA_PASSWORD=your_earthdata_password

# Optional contact identity sent to the PRISM web service
# PRISM_CONTACT_EMAIL=you@example.com
